# PostgreSQL
POSTGRES_URL=jdbc:postgresql://localhost:5432/luvax
POSTGRES_DB=luvax
POSTGRES_USER=
POSTGRES_PASSWORD=
# Connection pool (REM-08). Tune DB_POOL_MAX against your PostgreSQL max_connections.
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT_MS=3000

# Container OS/default-session timezone (postgres, rabbitmq). Also fixes DBeaver/pgjdbc clients
# that send the legacy IANA name "Asia/Saigon" instead of "Asia/Ho_Chi_Minh" as a connection
# startup parameter - see docker/postgres/Dockerfile.
TZ=Asia/Ho_Chi_Minh

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=
SPRING_RABBITMQ_PASSWORD=
SPRING_RABBITMQ_VIRTUAL_HOST=/
SPRING_RABBITMQ_PUBLISHER_CONFIRM_TYPE=correlated
SPRING_RABBITMQ_PUBLISHER_RETURNS=true
SPRING_RABBITMQ_TEMPLATE_MANDATORY=true
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_PUBLISHER_BATCH_SIZE=100
OUTBOX_PUBLISHER_MAX_ATTEMPTS=3
OUTBOX_PUBLISHER_CONFIRM_TIMEOUT=PT10S
OUTBOX_PUBLISHER_PROCESSING_TIMEOUT=PT2M
OUTBOX_PUBLISHER_INITIAL_DELAY=PT10S
OUTBOX_PUBLISHER_FIXED_DELAY=PT1S
OUTBOX_PUBLISHER_RETRY_BACKOFF_1=PT10S
OUTBOX_PUBLISHER_RETRY_BACKOFF_2=PT30S
OUTBOX_PUBLISHER_RETRY_BACKOFF_3=PT60S
RABBIT_CONSUMER_MAX_ATTEMPTS=3
RABBIT_CONSUMER_RETRY_BACKOFF_1=PT10S
RABBIT_CONSUMER_RETRY_BACKOFF_2=PT30S
RABBIT_CONSUMER_RETRY_BACKOFF_3=PT60S

# Auth
APP_COOKIE_SIGNING_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
JWT_ISSUER=Luvax
JWT_AUDIENCE=Luvax
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
AUTH_FORGOT_PASSWORD_MIN_RESPONSE_TIME=200ms
AUTH_FORGOT_PASSWORD_MAX_JITTER=50ms
# Refresh token purge job
RT_PURGE_EXPIRED_GRACE=PT1H
RT_PURGE_REVOKED_RETENTION=P7D
RT_PURGE_INITIAL_DELAY=PT5M
RT_PURGE_FIXED_DELAY=PT6H
# WebSocket session revocation sweep
WEBSOCKET_REVOCATION_INTERVAL=PT30S

# App
APP_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Mail (Resend)
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@domain.com
MAIL_FROM_NAME=domain
MAIL_APP_NAME=luvax
MAIL_VERIFY_EMAIL_PATH=/verify-email
MAIL_RESET_PASSWORD_PATH=/reset-password
MAIL_CONSUMER_ENABLED=true
NOTIFICATION_CONSUMER_ENABLED=true
NOTIFICATION_LIVE_ENABLED=false

# Elasticsearch
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_CONNECTION_TIMEOUT=PT5S
ELASTICSEARCH_SOCKET_TIMEOUT=PT30S

# Gorse recommender (gorse/docker-compose.gorse.yml + app.gorse.* properties)
GORSE_API_KEY=
GORSE_DASHBOARD_USER=
GORSE_DASHBOARD_PASSWORD=
APP_GORSE_BASE_URL=http://localhost:8088
RECOMMENDATION_CONSUMER_ENABLED=true

# Media
MEDIA_CDN_BASE_URL=https://cdn.example.com
MEDIA_STORAGE_KEY_PATTERN=^[a-zA-Z0-9][a-zA-Z0-9/_.-]{1,511}$
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_UPLOAD_URL_TTL=PT10M

# Hashtag
HASHTAG_SEED_ENABLED=true
HASHTAG_CONSUMER_ENABLED=false
HASHTAG_TRENDING_WINDOW=PT24H
HASHTAG_TRENDING_JOB_DELAY=PT1H
HASHTAG_TRENDING_JOB_INITIAL_DELAY=PT5M

# Post
POST_SEED_ENABLED=true
POST_CONSUMER_ENABLED=false

# Comment
COMMENT_SLOW_MODE_SECONDS=0
COMMENT_IDEMPOTENCY_TTL_HOURS=24
COMMENT_CONSUMER_ENABLED=false
COMMENT_LIVE_ENABLED=false

# Story
STORY_CONSUMER_ENABLED=false
STORY_CLEANUP_INITIAL_DELAY=PT10M
STORY_CLEANUP_FIXED_DELAY=PT1H

# Message
MESSAGE_GROUP_CHAT_ENABLED=true
MESSAGE_IDEMPOTENCY_TTL_HOURS=24
MESSAGE_MAX_GROUP_PARTICIPANTS=256
