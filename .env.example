# PostgreSQL
POSTGRES_URL=jdbc:postgresql://localhost:5432/luvax
POSTGRES_USER=
POSTGRES_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
SPRING_RABBITMQ_VIRTUAL_HOST=/
SPRING_RABBITMQ_PUBLISHER_CONFIRM_TYPE=correlated
SPRING_RABBITMQ_PUBLISHER_RETURNS=true
SPRING_RABBITMQ_TEMPLATE_MANDATORY=true
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_PUBLISHER_BATCH_SIZE=100
OUTBOX_PUBLISHER_MAX_ATTEMPTS=3
OUTBOX_PUBLISHER_CONFIRM_TIMEOUT=PT10S
OUTBOX_PUBLISHER_PROCESSING_TIMEOUT=PT2M
OUTBOX_PUBLISHER_INITIAL_DELAY=PT10S
OUTBOX_PUBLISHER_FIXED_DELAY=PT5S
OUTBOX_PUBLISHER_RETRY_BACKOFF_1=PT10S
OUTBOX_PUBLISHER_RETRY_BACKOFF_2=PT30S
OUTBOX_PUBLISHER_RETRY_BACKOFF_3=PT60S
RABBIT_CONSUMER_MAX_ATTEMPTS=3
RABBIT_CONSUMER_RETRY_BACKOFF_1=PT10S
RABBIT_CONSUMER_RETRY_BACKOFF_2=PT30S
RABBIT_CONSUMER_RETRY_BACKOFF_3=PT60S

# Auth
APP_COOKIE_SIGNING_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
JWT_ISSUER=Luvax
JWT_AUDIENCE=Luvax
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
AUTH_FORGOT_PASSWORD_MIN_RESPONSE_TIME=200ms
AUTH_FORGOT_PASSWORD_MAX_JITTER=50ms

# App
APP_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Mail (Resend)
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@domain.com
MAIL_FROM_NAME=domain
MAIL_APP_NAME=luvax
MAIL_VERIFY_EMAIL_PATH=/verify-email
MAIL_RESET_PASSWORD_PATH=/reset-password
MAIL_CONSUMER_ENABLED=true

# Elasticsearch
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_CONNECTION_TIMEOUT=PT5S
ELASTICSEARCH_SOCKET_TIMEOUT=PT30S

# Media
MEDIA_CDN_BASE_URL=https://cdn.example.com
MEDIA_STORAGE_KEY_PATTERN=^[a-zA-Z0-9][a-zA-Z0-9/_.-]{1,511}$
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_UPLOAD_URL_TTL=PT10M
